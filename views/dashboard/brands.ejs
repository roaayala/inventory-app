<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', title) %>
  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu }) %>

      <main class="container brands-page main-area">
        <section class="brands-page__header">
          <h1>Manage Brands</h1>
          <div class="brands-page__header-action">
            <a href="/dashboard/brands/new" class="button button--primary">
              <div class="button-icon icon-plus"></div>
              <span class="button-label">New Brand</span>
            </a>
          </div>
        </section>

        <section class="brands-page__main">
          <% if (brands && brands.length > 0) { %> <% brands.forEach(brand => {
          %>
          <%- include('../partials/simple-card', { name: brand.name, 
            total: brand.productTotal, 
            editLink: `/dashboard/brands/${brand.id}/edit`,
            deleteLink: `/dashboard/brands/${brand.id}` }) %>
          <% }) %>
          <% } else { %>
          <div class="empty-message">
            <span class="empty-message__text">No brand added yet!</span>
          </div>
          <% } %>
        </section>
      </main>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
