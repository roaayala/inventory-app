<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', title) %>
  <body>
    <div id="app" class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu, activeMenu }) %>

      <main class="container categories-page main-area">
        <section class="categories-page__header">
          <h1>Manage Categories</h1>
          <div class="categories-page__header-action">
            <a href="/dashboard/categories/new" class="button button--primary">
              <div class="button-icon icon-plus"></div>
              <span class="button-label">New Category</span>
            </a>
          </div>
        </section>

        <section class="categories-page__main">
          <% if (categories && categories.length > 0) { %> <%
          categories.forEach(category => { %>
          <%- include('../partials/simple-card', { name: category.name, 
            total: category.productTotal, 
            editLink: `/dashboard/categories/${category.id}/edit`,
            deleteLink: `/dashboard/categories/${category.id}`}) %>
          <% }) %>
          <% } else { %>
          <div class="empty-message">
            <span class="empty-message__text">No categories added yet!</span>
          </div>
          <% } %>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>
