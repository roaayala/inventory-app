<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', title) %>
  <body>
    <div id="app" class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu, activeMenu }) %>

      <main class="container dashboard-main">
        <header
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
          <h1 class="text-center sm:text-left">Manage Categories</h1>
          <div>
            <a
              href="/dashboard/categories/new"
              class="btn btn--neutral btn--outline w-full"
            >
              <span class="btn-icon">
                <div class="icon-plus"></div>
              </span>

              <span class="btn-label">New Product</span>
            </a>
          </div>
        </header>

        <section class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
          <% if (categories && categories.length > 0) { %> <%
          categories.forEach(category => { %>
          <%- include('../partials/simple-card', { name: category.name, 
            total: category.productTotal, 
            editLink: `/dashboard/categories/${category.id}/edit`,
            deleteLink: `/dashboard/categories/${category.id}`}) %>
          <% }) %>
          <% } else { %>
          <div>
            <span>No categories added yet!</span>
          </div>
          <% } %>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>
