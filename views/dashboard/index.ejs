<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header', { title }) %>

  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu, activeMenu }) %>

      <main class="container index-page main-area">
        <section class="index-page header">
          <h1>Welcome to dashboard, Admin!</h1>
          <p>Place to manage your products, categories and brands.</p>
        </section>

        <section class="index-page main">
          <h2>Quick Preview</h2>
          <div class="index-page content">
            <%- include('../partials/count-card', { count: productsCount,
            countSuffix: 'products', link: '/dashboard/products' }) %>
            <!--  -->
            <%- include('../partials/count-card', { count: categoriesCount, countSuffix: 'categories', link: '/dashboard/categories' }) %>
            <!--  -->
            <%- include('../partials/count-card', { count: brandsCount, countSuffix: 'brands', link: '/dashboard/brands' }) %>
          </div>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>
