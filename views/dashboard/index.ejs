<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header', title) %>
  <body>
    <div class="dashboard">
      <div class="dashboard__header">
        <div class="container">
          <h1><%= title %></h1>
        </div>
      </div>

      <div class="dashboard__body">
        <div class="container">
          <div class="dashboard__body-wrapper">
            <aside class="dashboard__sidebar">
              <form action="/dashboard" method="get" class="sidebar-filter">
                <!-- categories -->
                <div class="categories-filter">
                  <div class="categories-filter__header">
                    <h3>Product Categories</h3>
                  </div>

                  <div class="categories-filter__body">
                    <% if (categories && categories.length > 0) { %> <%
                    categories.forEach(category => { %>
                    <div class="field-group--inline">
                      <% const isChecked =
                      activeFilters.categories.includes(String(category.id)); %>
                      <% if (isChecked) { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= category.id %>"
                        value="<%= category.id %>"
                        checked
                      />
                      <% } else { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= category.id %>"
                        value="<%= category.id %>"
                      />
                      <% } %>

                      <label
                        class="checkbox-input-label"
                        for="<%= category.id %>"
                      >
                        <%= category.name %>
                      </label>
                    </div>

                    <% if (category.children && category.children.length > 0) {
                    %> <% category.children.forEach(children => { %>
                    <div class="field-group--inline-nested">
                      <% const isChildChecked =
                      activeFilters.categories.includes(String(children.id)); %>
                      <% if (isChildChecked) { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= children.id %>"
                        value="<%= children.id %>"
                        checked
                      />
                      <% } else { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= children.id %>"
                        value="<%= children.id %>"
                      />
                      <% } %>

                      <label
                        class="checkbox-input-label"
                        for="<%= children.id %>"
                      >
                        <%= children.name %>
                      </label>
                    </div>
                    <% }) %>
                    <% } %>

                    <% }) %>

                    <% } else { %>
                    <div class="empty-data">No categories added yet!</div>
                    <% } %>
                  </div>
                </div>

                <!-- brands -->
                <div class="brands-filter">
                  <div class="brands-filter__header">
                    <h3>Product Brands</h3>
                  </div>

                  <div class="brands-filter__body">
                    <% if (brands && brands.length > 0) { %> <%
                    brands.forEach(brand => { %>
                    <div class="field-group--inline">
                      <% const isBrandChecked =
                      activeFilters.brands.includes(String(brand.id)); %> <% if
                      (isBrandChecked) { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="brands"
                        id="<%= brand.id %>"
                        value="<%= brand.id %>"
                        checked
                      />
                      <% } else { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="brands"
                        id="<%= brand.id %>"
                        value="<%= brand.id %>"
                      />
                      <% } %>

                      <label class="checkbox-input-label" for="<%= brand.id %>">
                        <%= brand.name %></label
                      >
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="empty-data">No brands added yet!</div>
                    <% } %>
                  </div>
                </div>

                <!-- buttons -->
                <div class="form-actions">
                  <a href="/dashboard" class="button button--secondary">
                    Reset Filter
                  </a>
                  <button class="button button--primary" type="submit">
                    Apply Filter
                  </button>
                </div>
              </form>
            </aside>

            <div class="products">
              <div class="products__header">
                <h2 class="products__header-title">Products List</h2>

                <div class="products__header-actions">
                  <a href="#" class="button button--primary">New Product</a>
                </div>
              </div>
              <div class="products__body">
                <% if (products && products.length > 0) { %> <%
                products.forEach(product => { %>
                <div class="product-card">
                  <div class="product-card__header">
                    <h3 class="product-card__title"><%= product.name %></h3>

                    <div class="product-card__actions">
                      <a href="#" class="button button-small button--secondary"
                        >Edit</a
                      >
                      <a href="#" class="button button-small button--secondary"
                        >Delete</a
                      >
                    </div>
                  </div>

                  <ul class="product-card__details">
                    <li class="product-card__item">
                      <span class="detail-label">SKU:</span>
                      <span><%= product.sku %></span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Price:</span>
                      <span>Rp<%= stringifyPrice(product.price) %></span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Weight:</span>
                      <span>
                        <%= product.weight %>
                        Kg
                      </span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Brand:</span>
                      <span><%= product.brand.name %></span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Categories:</span>
                      <% if (product.categories && product.categories.length >
                      0) { %> <% product.categories.forEach(category => { %>
                      <span class="category-badge"><%= category.name %></span>
                      <% }) %>
                      <% } else { %>
                      <span class="text-muted">-</span>
                      <% } %>
                    </li>
                  </ul>
                </div>
                <% }) %>

                <% } else { %>
                <div class="product-card product-card--empty">
                  <div class="product-card__header">
                    <h3 class="product-card__title">No products found!</h3>
                  </div>
                </div>
                <%  } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </body>
</html>
