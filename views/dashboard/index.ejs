<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header', title) %>

  <body>
    <div class="dashboard-index">
      <nav class="dashboard-nav">
        <% dashboardMenu.forEach(menu => { %>

        <a
          href="<%= menu.link %>"
          class="dashboard-nav__link <%= activeMenu.label === menu.label ? 'dashboard-nav__link--active' : '' %>"
        >
          <div class="icon-<%= menu.icon %> dashboard-nav__link-icon"></div>
          <span class="dashboard-nav__link-label"><%= menu.label %></span>
        </a>

        <% }) %>
      </nav>

      <main class="dashboard-index__main">
        <div class="dashboard-index__main-header">
          <h1>Welcome to dashboard, Admin!</h1>
          <p>Place to manage your products, categories and brands.</p>
        </div>

        <div class="dashboard-index__main-content">
          <%- include('../partials/count-card', { count: productsCount,
          countSuffix: 'products', link: '/dashboard/products', linkLabel:
          'Manage products' }) %>
          <!--  -->
          <%- include('../partials/count-card', { 
            count: categoriesCount, 
            countSuffix: 'categories', 
            link: '/dashboard/categories', 
            linkLabel: 'Manage categories' 
          }) %>
          <!--  -->
          <%- include('../partials/count-card', { count: brandsCount, countSuffix:
          'brands', link: '/dashboard/brands', linkLabel: 'Manage brands' }) %>
        </div>
      </main>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
