<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', title) %>
  <body>
    <div class="dashboard">
      <div class="dashboard__header">
        <div class="container">
          <h1><%= title %></h1>
        </div>
      </div>

      <div class="dashboard__body">
        <div class="container">
          <div class="dashboard__body-wrapper">
            <aside class="dashboard__sidebar">
              <div>
                <h3>Product Categories</h3>
                <ul>
                  <% if (nestedCategories && nestedCategories.length>0) { %> <%
                  nestedCategories.forEach(category => { %>
                  <li>
                    <span><%= category.name %></span>
                    <% if (category.children && category.children.length > 0)
                    {%>
                    <ul>
                      <% category.children.forEach(subCat => { %>
                      <li>
                        <span><%= subCat.name %></span>
                      </li>
                      <% }) %>
                    </ul>
                    <% } %>
                  </li>
                  <% }) %>
                  <% } else { %>
                  <li>No categories</li>
                  <% } %>
                </ul>
              </div>

              <div>
                <h3>Product Brands</h3>
              </div>
            </aside>

            <div class="products">
              <div class="products__header">
                <h2 class="products__header-title">Products List</h2>

                <div class="products__header-actions">
                  <a href="#" class="button button--primary">New Product</a>
                </div>
              </div>

              <div class="products__body">
                <% products.forEach(product => { %>
                <div class="product-card">
                  <div class="product-card__header">
                    <h3 class="product-card__title"><%= product.name %></h3>

                    <div class="product-card__actions">
                      <a href="#" class="button button-small button--secondary"
                        >Edit</a
                      >
                      <a href="#" class="button button-small button--secondary"
                        >Delete</a
                      >
                    </div>
                  </div>

                  <ul class="product-card__details">
                    <li class="product-card__item">
                      <span class="detail-label">SKU:</span>
                      <span><%= product.sku %></span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Price:</span>
                      <span>Rp<%= stringifyPrice(product.price) %></span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Weight:</span>
                      <span>
                        <%= product.weight %>
                        Kg
                      </span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Brand:</span>
                      <span><%= product.brand.name %></span>
                    </li>
                    <li class="product-card__item">
                      <span class="detail-label">Categories:</span>
                      <% if (product.categories && product.categories.length >
                      0) { %> <% product.categories.forEach(category => { %>
                      <span class="category-badge"><%= category.name %></span>
                      <% }) %>
                      <% } else { %>
                      <span class="text-muted">-</span>
                      <% } %>
                    </li>
                  </ul>
                </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </body>
</html>
