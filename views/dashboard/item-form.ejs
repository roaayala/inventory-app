<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header', {title}) %>

  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu }) %>

      <main class="form-page">
        <form action="/dashboard/products" method="POST" class="form">
          <header class="form-header">
            <h1 class="form-header__title"><%= title %></h1>
          </header>

          <main class="form-main">
            <section class="field-group">
              <label for="productName" class="label">Product Name</label>
              <input
                value="<%= oldData.productName || '' %>"
                type="text"
                name="productName"
                id="productName"
                placeholder="Product Name"
                class="input"
                minlength="6"
                required
              />
            </section>

            <section class="field-group">
              <label for="productSKU" class="label">Product SKU</label>
              <input
                value="<%= oldData.productSKU || '' %>"
                type="text"
                name="productSKU"
                id="productSKU"
                placeholder="Product SKU"
                class="input"
                minlength="6"
                required
              />
            </section>

            <section class="field-group">
              <label for="productPrice" class="label">Product Price</label>
              <input
                value="<%= oldData.productPrice || '' %>"
                type="number"
                name="productPrice"
                id="prdouctPrice"
                placeholder="Product Price"
                class="input"
                min="1"
                required
              />
            </section>

            <section class="field-group">
              <label for="productWeight" class="label">Product Weight</label>
              <input
                value="<%= oldData.productWeight || '' %>"
                type="Number"
                name="productWeight"
                id="productWeight"
                placeholder="Product Weight"
                class="input"
                min="1"
                required
              />
            </section>

            <section class="field-group">
              <label for="productCategory" class="label">
                Product Category</label
              >
              <select
                name="productCategory"
                id="productCategory"
                class="select"
              >
                <% categories.forEach(category => { %>
                <% const isSelected = (oldData?.productCategory === category.id) || (!oldData?.productCategory && category.name === 'Uncategorized'); %>

                <% if (isSelected) { %>
                <option value="<%= category.id %>" class="option" selected>
                  <%= category.name %>
                </option>
                <% } else { %>
                <option value="<%= category.id %>" class="option">
                  <%= category.name %>
                </option>
                <% } %>
                <% }) %>
              </select>
            </section>

            <section class="field-group">
              <label for="productBrand" class="label">Product Brand</label>
              <select name="productBrand" id="productBrand" class="select">
                <% brands.forEach(brand => { %>
                <% const isSelected = (oldData?.productBrand === brand.id) || (!oldData?.productBrand && brand.name === 'No Brand'); %>

                <% if (isSelected) { %>
                <option value="<%= brand.id %>" class="option" selected>
                  <%= brand.name %>
                </option>
                <% } else { %>
                <option value="<%= brand.id %>" class="option">
                  <%= brand.name %>
                </option>
                <% } %>
                <% }) %>
              </select>
            </section>
          </main>

          <footer class="form-footer">
            <a href="#" class="button button--outline">Cancel</a>
            <button type="submit" class="button button--primary">Save</button>
          </footer>

          <% if (errors && errors.length >=1) { %>
          <div class="form-error-box">
            <ul class="error-lists">
              <% errors.forEach(error => { %>
              <li class="error-message"><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
          <% } %>
        </form>
      </main>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
