<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header', { title }) %>

  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu }) %>

      <main class="form-page">
        <form action="<%= formUrlEndpoint %>" method="POST" class="form-item">
          <header class="form-item-header">
            <h1 class="form-item-header__title"><%= title %></h1>
          </header>

          <main class="form-item-main">
            <section class="field-group">
              <label for="name" class="label"
                ><%= fieldNamePrefix %>
                Name</label
              >
              <input
                value="<%= oldData.name || '' %>"
                type="text"
                name="name"
                id="name"
                placeholder="<%= fieldNamePrefix %> Name"
                class="input"
                minlength="6"
                required
              />
            </section>

            <% if (isProductForm) { %>
            <section class="field-group">
              <label for="sku" class="label"><%= fieldNamePrefix %> SKU</label>
              <input
                value="<%= oldData.sku || '' %>"
                type="text"
                name="sku"
                id="sku"
                placeholder="<%= fieldNamePrefix %> SKU"
                class="input"
                minlength="6"
                required
              />
            </section>

            <section class="field-group">
              <label for="price" class="label"
                ><%= fieldNamePrefix %> Price</label
              >
              <input
                value="<%= oldData.price || '' %>"
                type="number"
                name="price"
                id="price"
                placeholder="<%= fieldNamePrefix %> Price"
                class="input"
                min="1"
                required
              />
            </section>

            <section class="field-group">
              <label for="weight" class="label"
                ><%= fieldNamePrefix %> Weight</label
              >
              <input
                value="<%= oldData.weight || '' %>"
                type="Number"
                name="weight"
                id="weight"
                placeholder="<%= fieldNamePrefix %> Weight"
                class="input"
                min="1"
                required
              />
            </section>

            <section class="field-group">
              <label for="categoryId" class="label">
                <%= fieldNamePrefix %> Category</label
              >
              <select name="categoryId" id="categoryId" class="select">
                <% categories.forEach(category => { %>
                <% const isSelected = (oldData?.categoryId === category.id) || (!oldData?.categoryId && category.name === 'Uncategorized'); %>

                <% if (isSelected) { %>
                <option value="<%= category.id %>" class="option" selected>
                  <%= category.name %>
                </option>
                <% } else { %>
                <option value="<%= category.id %>" class="option">
                  <%= category.name %>
                </option>
                <% } %>
                <% }) %>
              </select>
            </section>

            <section class="field-group">
              <label for="branIdd" class="label"
                ><%= fieldNamePrefix %> Brand</label
              >
              <select name="brandId" id="brand" class="select">
                <% brands.forEach(brand => { %>
                <% const isSelected = (oldData?.brandId === brand.id) || (!oldData?.brandId && brand.name === 'No Brand'); %>

                <% if (isSelected) { %>
                <option value="<%= brand.id %>" class="option" selected>
                  <%= brand.name %>
                </option>
                <% } else { %>
                <option value="<%= brand.id %>" class="option">
                  <%= brand.name %>
                </option>
                <% } %>
                <% }) %>
              </select>
            </section>
            <% } %>
          </main>

          <footer class="form-item-footer">
            <a href="<%= prevPage %> " class="button button--outline">Cancel</a>
            <button type="submit" class="button button--primary">Save</button>
          </footer>

          <%- include('../partials/error-box', { errors }) %>
        </form>
      </main>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
