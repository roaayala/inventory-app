<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', title) %>
  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu }) %>

      <main class="dashboard-main">
        <div class="products-page main-header">
          <h1 class="main-header__title">Manage Products</h1>
          <div class="main-header-actions">
            <a
              href="/dashboard/products/new"
              class="button button--full button--primary"
            >
              <div class="button-icon icon-plus"></div>
              <span class="button-label">New Product</span>
            </a>
          </div>
        </div>

        <div class="products-page main-content">
          <section class="filter-card">
            <header class="filter-header">
              <h3 class="filter-header__title">Filter Products</h3>

              <div class="filter-header__actions">
                <button
                  class="button button--icon button--outline"
                  id="toggleFilter"
                >
                  <div
                    class="icon-button icon-eye-off"
                    id="toggleFilterIcon"
                  ></div>
                </button>
              </div>
            </header>

            <form
              action="/dashboard/products"
              method="get"
              class="filter-form"
              id="dashboardFilterForm"
            >
              <main class="form-main">
                <section class="form-section">
                  <h3 class="form-section__title">Filter by Categories</h3>
                  <div class="form-section__lists">
                    <% if (categories && categories.length > 0) { %> <%
                    categories.forEach(category => { %>
                    <div class="field-group--inline">
                      <% const isChecked =
                      activeFilters.categories.includes(String(category.id)); %>
                      <% if (isChecked) { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= category.id %>"
                        value="<%= category.id %>"
                        checked
                      />
                      <% } else { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= category.id %>"
                        value="<%= category.id %>"
                      />
                      <% } %>

                      <label
                        class="checkbox-input__label"
                        for="<%= category.id %>"
                      >
                        <%= category.name %>
                      </label>
                    </div>

                    <% if (category.children && category.children.length > 0) {
                    %> <% category.children.forEach(children => { %>
                    <div class="field-group--inline-nested">
                      <% const isChildChecked =
                      activeFilters.categories.includes(String(children.id)); %>
                      <% if (isChildChecked) { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= children.id %>"
                        value="<%= children.id %>"
                        checked
                      />
                      <% } else { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="categories"
                        id="<%= children.id %>"
                        value="<%= children.id %>"
                      />
                      <% } %>

                      <label
                        class="checkbox-input-label"
                        for="<%= children.id %>"
                      >
                        <%= children.name %>
                      </label>
                    </div>
                    <% }) %>
                    <% } %>

                    <% }) %>

                    <% } else { %>
                    <div class="empty-data">No categories added yet!</div>
                    <% } %>
                  </div>
                </section>
                <section class="form-section">
                  <h3 class="form-section__title">Filter by Brands</h3>
                  <div class="form-section__lists">
                    <% if (brands && brands.length > 0) { %> <%
                    brands.forEach(brand => { %>
                    <div class="field-group--inline">
                      <% const isBrandChecked =
                      activeFilters.brands.includes(String(brand.id)); %> <% if
                      (isBrandChecked) { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="brands"
                        id="<%= brand.id %>"
                        value="<%= brand.id %>"
                        checked
                      />
                      <% } else { %>
                      <input
                        class="checkbox-input"
                        type="checkbox"
                        name="brands"
                        id="<%= brand.id %>"
                        value="<%= brand.id %>"
                      />
                      <% } %>

                      <label
                        class="checkbox-input__label"
                        for="<%= brand.id %>"
                      >
                        <%= brand.name %></label
                      >
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="empty-data">No brands added yet!</div>
                    <% } %>
                  </div>
                </section>
              </main>

              <footer class="form-footer">
                <a
                  href="/dashboard/products"
                  class="button button--full button--outline"
                >
                  Clear Filter
                </a>
                <button
                  type="submit"
                  class="button button--full button--primary"
                >
                  Apply Filter
                </button>
              </footer>
            </form>
          </section>

          <section class="products-list">
            <header class="products-header">
              <h2 class="products-header__title">Products List</h2>
            </header>

            <main class="products-container">
              <% if (products && products.length > 0) { %> <%
              products.forEach(product => { %>
              <div class="product-card">
                <header class="product-card__header">
                  <h3 class="product-card__title"><%= product.name %></h3>
                  <div class="product-card__actions">
                    <a href="#" class="button button--icon button--outline">
                      <div class="icon-button icon-square-pen"></div>
                    </a>
                    <a href="#" class="button button--icon button--outline">
                      <div class="icon-button icon-trash-2"></div>
                    </a>
                  </div>
                </header>

                <ul class="product-card__details">
                  <li class="product-card__item">
                    <span class="detail-label">SKU:</span>
                    <span><%= product.sku %></span>
                  </li>
                  <li class="product-card__item">
                    <span class="detail-label">Price:</span>
                    <span>Rp<%= stringifyPrice(product.price) %></span>
                  </li>
                  <li class="product-card__item">
                    <span class="detail-label">Weight:</span>
                    <span>
                      <%= product.weight %>
                      Kg
                    </span>
                  </li>
                  <li class="product-card__item">
                    <span class="detail-label">Brand:</span>
                    <span><%= product.brand.name %></span>
                  </li>
                  <li class="product-card__item">
                    <span class="detail-label">Categories:</span>
                    <% if (product.categories && product.categories.length > 0)
                    { %> <% product.categories.forEach(category => { %>
                    <span class="badge"><%= category.name %></span>
                    <% }) %>
                    <% } else { %>
                    <span class="text-muted">-</span>
                    <% } %>
                  </li>
                </ul>
              </div>
              <% }) %>
              <% } else { %>
              <div class="product-card">
                <div class="product-card product-card--empty">
                  <div class="product-card__header">
                    <h3 class="product-card__title">No products found!</h3>
                  </div>
                </div>
              </div>
              <% } %>
            </main>
          </section>
        </div>
      </main>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
