<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', { title }) %>
  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu, activeMenu }) %>

      <main id="app" class="container products-page main-area">
        <section class="header">
          <h1>Manage Products</h1>
          <div class="header-action">
            <a href="/dashboard/products/new" class="button button--primary">
              <div class="button-icon icon-plus"></div>
              <span class="button-label">New Product</span>
            </a>
          </div>
        </section>

        <section class="main">
          <%- include('../partials/filter-card', { categories }) %>

          <section class="content">
            <h2 class="content__title">Products List</h2>

            <main class="products">
              <% if (products && products.length > 0) { %> <%
              products.forEach(product => { %>
              <%- include('../partials/product-card', { product }) %>
              <% }) %>
              <% } else { %>
              <%- include('../partials/product-card', { product: false }) %>
              <% } %>
            </main>
          </section>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>
