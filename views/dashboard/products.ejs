<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', { title }) %>
  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu, activeMenu }) %>

      <main id="app" class="container dashboard-main">
        <header
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
          <h1>Manage Products</h1>
          <div>
            <a href="/dashboard/products/new" class="btn btn--outline w-full">
              <span class="btn-icon">
                <div class="icon-plus"></div>
              </span>

              <span class="btn-label">New Product</span>
            </a>
          </div>
        </header>

        <section class="grid gap-6 md:grid-cols-[20rem_1fr]">
          <%- include('../partials/filter-card', { categories }) %>

          <section class="bg-primary-container p-8">
            <h2 class="content__title">Products List</h2>

            <main class="products">
              <% if (products && products.length > 0) { %> <%
              products.forEach(product => { %>
              <%- include('../partials/product-card', { product }) %>
              <% }) %>
              <% } else { %>
              <%- include('../partials/product-card', { product: false }) %>
              <% } %>
            </main>
          </section>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>
