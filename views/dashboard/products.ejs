<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', { title }) %>
  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu, activeMenu }) %>

      <main class="container products-page main-area">
        <section class="products-page header">
          <h1>Manage Products</h1>
          <div class="products-page header-action">
            <a
              href="/dashboard/products/new"
              class="button button--primary button--outline"
            >
              <div class="button-icon icon-plus"></div>
              <span class="button-label">New Product</span>
            </a>
          </div>
        </section>

        <div class="products-page main">
          <%- include('../partials/filter-card', { categories }) %>

          <section class="products-list">
            <header class="products-header">
              <h2 class="products-header__title">Products List</h2>
            </header>

            <main class="products-container">
              <% if (products && products.length > 0) { %> <%
              products.forEach(product => { %>
              <%- include('../partials/product-card', { product }) %>
              <% }) %>
              <% } else { %>
              <%- include('../partials/product-card', { product: false }) %>
              <% } %>
            </main>
          </section>
        </div>
      </main>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
