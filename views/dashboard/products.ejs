<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/header.ejs', { title }) %>
  <body>
    <div class="dashboard-layout">
      <%- include('../partials/dashboard-nav', { dashboardMenu, activeMenu }) %>

      <main id="app" class="container dashboard-main">
        <header
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
          <h1 class="text-center sm:text-left">Manage Products</h1>
          <div>
            <a
              href="/dashboard/products/new"
              class="btn btn--neutral btn--outline w-full"
            >
              <span class="btn-icon">
                <div class="icon-plus"></div>
              </span>

              <span class="btn-label">New Product</span>
            </a>
          </div>
        </header>

        <section class="grid gap-6 grid-cols-1 md:grid-cols-[20rem_1fr]">
          <%- include('../partials/filter-card', { categories }) %>

          <section
            class="flex flex-col gap-4 bg-primary-container p-6 rounded-2xl"
          >
            <h2 class="text-2xl">Products List</h2>

            <main class="min-w-0 grid grid-cols-1 lg:grid-cols-2 gap-4">
              <% if (products && products.length > 0) { %> <%
              products.forEach(product => { %>
              <%- include('../partials/product-card', { product }) %>
              <% }) %>
              <% } else { %>
              <%- include('../partials/product-card', { product: false }) %>
              <% } %>
            </main>
          </section>
        </section>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>
