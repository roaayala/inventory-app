<div class="count-card">
  <span class="count-card__text">
    <span class="count-card__text-main"><%= count %></span>
    <span class="count-card__text-suffix"><%= countSuffix %></span>
  </span>

  <div class="count-card__actions">
    <a href="<%= link %>" class="button button--primary">
      <span class="button-label"><%= linkLabel %></span>
      <div class="button-icon icon-move-right"></div>
    </a>
  </div>
</div>
