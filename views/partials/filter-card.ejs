<section class="filter-card">
  <header class="filter-header">
    <h3 class="filter-header__title">Filter Products</h3>

    <div class="filter-header__actions">
      <button class="button button--icon button--outline" id="toggleFilter">
        <div class="icon-button icon-eye-off" id="toggleFilterIcon"></div>
      </button>
    </div>
  </header>

  <form
    action="/dashboard/products"
    method="get"
    class="filter-form"
    id="dashboardFilterForm"
  >
    <main class="form-main">
      <section class="form-section">
        <h3 class="form-section__title">Filter by Categories</h3>
        <div class="form-section__lists">
          <% if (categories && categories.length > 0) { %> <%
          categories.forEach(category => { %>
          <div class="field-group--inline">
            <% const isChecked =
            activeFilters.categories.includes(String(category.id)); %> <% if
            (isChecked) { %>
            <input
              class="checkbox-input"
              type="checkbox"
              name="categories"
              id="<%= category.id %>"
              value="<%= category.id %>"
              checked
            />
            <% } else { %>
            <input
              class="checkbox-input"
              type="checkbox"
              name="categories"
              id="<%= category.id %>"
              value="<%= category.id %>"
            />
            <% } %>

            <label class="label" for="<%= category.id %>">
              <%= category.name %>
            </label>
          </div>

          <% if (category.children && category.children.length > 0) { %> <%
          category.children.forEach(children => { %>
          <div class="field-group--inline-nested">
            <% const isChildChecked =
            activeFilters.categories.includes(String(children.id)); %> <% if
            (isChildChecked) { %>
            <input
              class="checkbox-input"
              type="checkbox"
              name="categories"
              id="<%= children.id %>"
              value="<%= children.id %>"
              checked
            />
            <% } else { %>
            <input
              class="checkbox-input"
              type="checkbox"
              name="categories"
              id="<%= children.id %>"
              value="<%= children.id %>"
            />
            <% } %>

            <label class="checkbox-input-label" for="<%= children.id %>">
              <%= children.name %>
            </label>
          </div>
          <% }) %>
          <% } %>

          <% }) %>

          <% } else { %>
          <div class="empty-data">No categories added yet!</div>
          <% } %>
        </div>
      </section>
      <section class="form-section">
        <h3 class="form-section__title">Filter by Brands</h3>
        <div class="form-section__lists">
          <% if (brands && brands.length > 0) { %> <% brands.forEach(brand => {
          %>
          <div class="field-group--inline">
            <% const isBrandChecked =
            activeFilters.brands.includes(String(brand.id)); %> <% if
            (isBrandChecked) { %>
            <input
              class="checkbox-input"
              type="checkbox"
              name="brands"
              id="<%= brand.id %>"
              value="<%= brand.id %>"
              checked
            />
            <% } else { %>
            <input
              class="checkbox-input"
              type="checkbox"
              name="brands"
              id="<%= brand.id %>"
              value="<%= brand.id %>"
            />
            <% } %>

            <label class="checkbox-input__label" for="<%= brand.id %>">
              <%= brand.name %></label
            >
          </div>
          <% }) %>
          <% } else { %>
          <div class="empty-data">No brands added yet!</div>
          <% } %>
        </div>
      </section>
    </main>

    <footer class="form-footer">
      <a href="/dashboard/products" class="button button--full button--outline">
        Clear Filter
      </a>
      <button type="submit" class="button button--full button--primary">
        Apply Filter
      </button>
    </footer>
  </form>
</section>
