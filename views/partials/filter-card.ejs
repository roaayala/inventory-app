<section
  class="min-w-0 self-start flex flex-col gap-2 p-4 rounded-2xl bg-surface-container/50"
>
  <header class="flex items-center justify-between">
    <h2 class="text-xl font-bold">Filter Products</h2>

    <div>
      <button class="btn btn--neutral btn--outline" id="toggleFilter">
        <div class="btn-icon icon-eye-off" id="toggleFilterIcon"></div>
      </button>
    </div>
  </header>

  <form
    action="/dashboard/products"
    method="get"
    class="flex flex-col gap-4"
    id="dashboardFilterForm"
  >
    <section class="flex flex-col gap-2">
      <h3 class="text-base text-on-surface/80">Filter by Categories</h3>
      <div class="flex flex-col gap-2">
        <% if (categories && categories.length > 0) {
        categories.forEach(category => { %>

        <div class="pl-1 flex items-center gap-2">
          <% const isChecked =
          activeFilters.categories.includes(String(category.id)); if (isChecked)
          { %>
          <input
            type="checkbox"
            name="categories"
            id="<%= category.id %>"
            value="<%= category.id %>"
            checked
          />
          <% } else { %>
          <input
            type="checkbox"
            name="categories"
            id="<%= category.id %>"
            value="<%= category.id %>"
          />
          <% } %>

          <label class="text-sm text-on-surface/60" for="<%= category.id %>">
            <%= category.name %>
          </label>
        </div>

        <% }) 
         } else { %>
        <div class="empty-data">No categories added yet!</div>
        <% } %>
      </div>
    </section>

    <section class="flex flex-col gap-2">
      <h3 class="text-base text-on-surface/80">Filter by Brands</h3>
      <div class="flex flex-col gap-2">
        <% if (brands && brands.length > 0) { %> <% brands.forEach(brand => { %>
        <div class="pl-1 flex items-center gap-2">
          <% const isBrandChecked =
          activeFilters.brands.includes(String(brand.id)); %> <% if
          (isBrandChecked) { %>
          <input
            type="checkbox"
            name="brands"
            id="<%= brand.id %>"
            value="<%= brand.id %>"
            checked
          />
          <% } else { %>
          <input
            type="checkbox"
            name="brands"
            id="<%= brand.id %>"
            value="<%= brand.id %>"
          />
          <% } %>

          <label class="text-sm text-on-surface/60" for="<%= brand.id %>">
            <%= brand.name %></label
          >
        </div>
        <% }) %>
        <% } else { %>
        <div class="empty-data">No brands added yet!</div>
        <% } %>
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <a href="/dashboard/products" class="btn btn--neutral btn--outline">
        <span class="btn-label">Clear Filter</span>
      </a>

      <button type="submit" class="btn btn--primary">
        <span class="btn-label">Apply Filter</span>
      </button>
    </section>
  </form>
</section>
