<% if (!product) { %>
<div>
  <div>
    <div>
      <h3>No products found!</h3>
    </div>
  </div>
</div>
<% } else { %>
<div class="min-w-0 p-4 bg-surface rounded-2xl flex flex-col gap-1">
  <header class="flex items-center justify-between gap-2">
    <h3 class="text-base truncate"><%= product.name %></h3>
    <div class="flex items-center gap-2 shrink">
      <a
        href="/dashboard/products/<%= product.id %>/edit"
        class="btn btn--neutral btn--ghost p-0"
      >
        <div class="btn-icon icon-square-pen"></div>
      </a>
      <form
        action="/dashboard/products/<%= product.id %>?_method=DELETE"
        method="POST"
        class="flex items-center"
      >
        <button type="submit" class="btn btn--neutral btn--ghost p-0">
          <div class="btn-icon icon-trash-2"></div>
        </button>
      </form>
    </div>
  </header>

  <ul class="flex flex-col p-0 list-none">
    <li>
      <span class="text-on-surface/60 text-sm">SKU:</span>
      <span class="text-on-surface/80 text-sm"><%= product.sku %></span>
    </li>

    <li>
      <span class="text-on-surface/60 text-sm">Price:</span>
      <span class="text-on-surface/80 text-sm">
        Rp<%= stringifyPrice(product.price) %>
      </span>
    </li>

    <li>
      <span class="text-on-surface/60 text-sm">Weight:</span>
      <span class="text-on-surface/80 text-sm"> <%= product.weight %> Kg </span>
    </li>

    <li>
      <span class="text-on-surface/60 text-sm">Brand:</span>
      <span class="text-on-surface/80 text-sm">
        <%= product.brand?.name || '-' %>
      </span>
    </li>

    <li>
      <span class="text-on-surface/60 text-sm">Categories:</span>
      <% if (product.category) { %>
      <span class="text-on-surface/80 text-sm">
        <%= product.category.name %>
      </span>
      <% } else { %>
      <span class="text-on-surface/80 text-sm">-</span>
      <% } %>
    </li>
  </ul>
</div>
<% } %>
