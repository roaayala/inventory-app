<% if (!product) { %>
<div class="product-card">
  <div class="product-card product-card--empty">
    <div class="product-card__header">
      <h3 class="product-card__title">No products found!</h3>
    </div>
  </div>
</div>
<% } else { %>
<div class="product-card">
  <header class="product-card__header">
    <h3 class="product-card__title"><%= product.name %></h3>
    <div class="product-card__action">
      <a
        href="/dashboard/products/<%= product.id %>/edit"
        class="button button--neutral button--ghost"
      >
        <div class="button-icon icon-square-pen"></div>
      </a>
      <form
        action="/dashboard/products/<%= product.id %>?_method=DELETE"
        method="POST"
      >
        <button type="submit" class="button button--neutral button--ghost">
          <div class="button-icon icon-trash-2"></div>
        </button>
      </form>
    </div>
  </header>

  <ul class="product-card__details">
    <li class="product-card__detail-item">
      <span class="product-card__detail-label">SKU:</span>
      <span class="product-card__detail-value"><%= product.sku %></span>
    </li>

    <li class="product-card__item">
      <span class="product-card__detail-label">Price:</span>
      <span class="product-card__detail-value">
        Rp<%= stringifyPrice(product.price) %>
      </span>
    </li>

    <li class="product-card__item">
      <span class="product-card__detail-label">Weight:</span>
      <span class="product-card__detail-value"> <%= product.weight %> Kg </span>
    </li>

    <li class="product-card__item">
      <span class="product-card__detail-label">Brand:</span>
      <span class="product-card__detail-value">
        <%= product.brand?.name || '-' %>
      </span>
    </li>

    <li class="product-card__item">
      <span class="product-card__detail-label">Categories:</span>
      <% if (product.category) { %>
      <span class="product-card__detail-value">
        <%= product.category.name %>
      </span>
      <% } else { %>
      <span class="product-card__detail-value">-</span>
      <% } %>
    </li>
  </ul>
</div>
<% } %>
