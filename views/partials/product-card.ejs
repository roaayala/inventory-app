<% if (!product) { %>
<div>
  <h3>No products found!</h3>
</div>
<% } else { %>
<div class="min-w-0 p-4 bg-surface rounded-2xl flex flex-col gap-1">
  <header class="flex items-center justify-between gap-2">
    <h3 class="text-lg truncate"><%= product.name %></h3>
    <div class="flex items-center gap-2 shrink">
      <a
        href="/dashboard/products/<%= product.id %>/edit"
        class="btn btn--neutral btn--ghost p-0"
      >
        <div class="btn-icon icon-square-pen"></div>
      </a>
      <form
        action="/dashboard/products/<%= product.id %>?_method=DELETE"
        method="POST"
        class="flex items-center"
      >
        <button type="submit" class="btn btn--neutral btn--ghost p-0">
          <div class="btn-icon icon-trash-2"></div>
        </button>
      </form>
    </div>
  </header>

  <ul class="pl-4 list-disc flex flex-col gap-1">
    <li class="text-on-surface/80 text-sm">SKU: <%= product.sku %></li>

    <li class="text-on-surface/80 text-sm">
      Price: Rp<%= stringifyPrice(product.price) %>
    </li>

    <li class="text-on-surface/80 text-sm">Weight: <%= product.weight %> Kg</li>

    <li class="text-on-surface/80 text-sm">
      Brand: <%= product.brand?.name || '-' %>
    </li>

    <li class="text-on-surface/80 text-sm">
      Categories: <%= product.category ? product.category.name : '-' %>
    </li>
  </ul>
</div>
<% } %>
