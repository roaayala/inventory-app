<div class="simple-card">
  <div class="simple-card__header">
    <h2 class="simple-card__title"><%= name %></h2>
    <span class="simple-card__count">
      <span class="simple-card__count-value"><%= total %></span>
      <span class="simple-card__count-suffix">
        <%= total === 1 ? 'item' : 'items' %>
      </span>
    </span>
  </div>

  <div class="simple-card__action">
    <a href="<%= editLink %>" class="button button--neutral button--ghost">
      <div class="button-icon icon-square-pen"></div>
    </a>
    <form action="<%= deleteLink %>?_method=DELETE" method="POST">
      <button type="submit" class="button button--neutral button--ghost">
        <div class="button-icon icon-trash-2"></div>
      </button>
    </form>
  </div>
</div>
